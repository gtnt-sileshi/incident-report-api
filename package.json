{
  "name": "exam-incident-support-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for the Exam Incident & Support Portal",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "seed:superadmin": "ts-node src/db/seed-superadmin.ts",
    "clear:revocations": "ts-node src/db/clear-revocations.ts",
    "fix:org-permissions": "ts-node src/db/fix-org-permissions.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPattern='tests/unit' --runInBand",
    "test:integration": "jest --testPathPattern='tests/integration' --runInBand",
    "test:property": "jest --testPathPattern='tests/property' --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.30.10",
    "exceljs": "4.4.0",
    "express": "4.18.2",
    "fast-check": "3.15.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "pdfkit": "0.14.0",
    "pg": "8.11.3",
    "uuid": "9.0.1",
    "web-push": "3.6.7",
    "ws": "8.16.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.5",
    "@types/multer": "1.4.11",
    "@types/node": "20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "0.13.4",
    "@types/pg": "8.10.9",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.7",
    "@types/web-push": "3.6.3",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "nodemon": "3.0.3",
    "prettier": "3.2.4",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
